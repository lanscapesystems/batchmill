[Unit]
Description=Feedmill EtherCAT I/O daemon (digital, analog, rotation)
After=ethercat.service
Requires=ethercat.service

[Service]
Type=simple
# Start from a fresh bus read: the master copies its cached PDO list into the daemon's configuration, and that list has been
# seen on the mill without any inputs until a rescan. "-": a failed rescan must not keep the I/O down.
ExecStartPre=-/usr/local/bin/ethercat rescan
ExecStartPre=/bin/sleep 2
ExecStart=/opt/feedmill/current/ethercat-rt/io-daemon /etc/feedmill/io.conf
Restart=on-failure
RestartSec=2
# Needed for mlockall()/SCHED_FIFO in io_daemon.c without running as root:
CapabilityBoundingSet=CAP_SYS_NICE CAP_IPC_LOCK
AmbientCapabilities=CAP_SYS_NICE CAP_IPC_LOCK
LimitRTPRIO=99
LimitMEMLOCK=infinity
RuntimeDirectory=feedmill
# The backend writes io-command.txt in this runtime directory.
User=feedmill
Group=feedmill
SupplementaryGroups=ethercat

[Install]
WantedBy=multi-user.target
