{
  "name": "feedmill-backend",
  "version": "0.1.10",
  "private": true,
  "scripts": {
    "dev": "tsx watch --ignore ./data src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "check": "tsx src/phase1.check.ts && tsx src/phase2.check.ts && tsx src/ethercat.check.ts"
  },
  "dependencies": {
    "better-sqlite3": "^13.2.0",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "serialport": "^12.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/ws": "^8.5.12",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "allowScripts": {
    "better-sqlite3@13.2.0": true,
    "@serialport/bindings-cpp@12.0.1": true
  }
}
