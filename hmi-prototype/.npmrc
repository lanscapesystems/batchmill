# npm 12 defaults to blocking direct-URL/tarball dependencies ("EALLOWREMOTE").
# xlsx is pinned to a SheetJS CDN tarball in package.json because the npm
# registry copy is unpatched (see the commit that added it) -- allow just
# this project's own root-level remote dependency, not any transitive one
# a compromised sub-dependency might sneak in.
allow-remote=root
